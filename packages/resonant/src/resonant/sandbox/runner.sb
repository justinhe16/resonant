;; Seatbelt profile for Claude runner sessions (docs/phase5a-plan.md, D1).
;; A wall, not a gate: allow by default, then enumerated denies. SBPL is last-match-wins,
;; so every deny that must hold sits AFTER the allows it overrides. Every path arrives as a
;; -D parameter (see profile.py); nothing is spliced into this text.
(version 1)
(allow default)

;; ---- file write: deny everywhere, then the run dir and cache ----------------------------
(deny file-write*)
(allow file-write*
  (subpath (param "RUN"))
  (subpath (param "CACHE"))
  (literal "/dev/null")
  (literal "/dev/dtracehelper")
  (literal "/dev/tty"))  ; headless sessions only: no ptys, no other terminals

;; ---- file read: deny the owner's world, then allow the run's own paths ------------------
(deny file-read*
  (subpath (param "HOME"))
  (subpath "/Volumes")
  (subpath "/Users/Shared")
  (subpath "/private/tmp")
  (subpath "/private/var/folders"))
(allow file-read*
  (subpath (param "RUN"))
  (subpath (param "CACHE"))
;; @READ_ALLOW@
  )
;; stat only on the ancestors of the allowed paths, so realpath and getcwd work
(allow file-read-metadata
;; @META_ALLOW@
  )
;; never readable, even if a toolchain path above sits inside one
(deny file-read*
  (subpath (string-append (param "HOME") "/.resonant"))
  (subpath (string-append (param "HOME") "/.ssh"))
  (subpath (string-append (param "HOME") "/.aws"))
  (subpath (string-append (param "HOME") "/.config/gh"))
  (subpath (string-append (param "HOME") "/.claude"))
  (subpath (string-append (param "HOME") "/Library"))
  (subpath (string-append (param "HOME") "/.local/bin")))

;; ---- exec: defense in depth (the mach denies below do the real work) ---------------------
(deny process-exec
  (literal "/usr/bin/security")
  (literal "/usr/bin/osascript")
  (literal "/usr/bin/open")
  (literal "/bin/launchctl")
  (literal "/usr/bin/shortcuts")
  (literal "/usr/bin/crontab")
  (literal "/usr/bin/at")
  (literal "/usr/bin/sudo")
  (literal "/usr/sbin/screencapture")
;; @DENY_EXEC@
  )

;; ---- mach / IPC: nothing may act outside the sandbox on the owner's behalf --------------
(deny mach-lookup
  (global-name-prefix "com.apple.xpc.launchd")
  (global-name "com.apple.SecurityServer")
  (global-name-prefix "com.apple.securityd")
  (global-name-prefix "com.apple.windowserver")
  (global-name-prefix "com.apple.hidsystem")
  (global-name-prefix "com.apple.accessibility")
  (global-name-prefix "com.apple.universalaccessd")
  (global-name "com.apple.coreservices.appleevents")
  (global-name "com.apple.coreservices.appleevent-send")
  (global-name "com.apple.coreservices.launchservicesd")
  (global-name-prefix "com.apple.lsd.")
  (global-name-prefix "com.apple.pasteboard.")
  (global-name-prefix "com.apple.tccd"))
;; Apple Events and LaunchServices opens are checked as operations, not only as lookups
(deny appleevent-send)
(deny lsopen)
;; synthetic input straight through the HID drivers
(deny iokit-open-user-client
  (iokit-user-client-class "IOHIDParamUserClient")
  (iokit-user-client-class "IOHIDLibUserClient")
  (iokit-user-client-class "IOHIDEventServiceUserClient"))
(deny mach-priv-task-port)
(deny mach-task-name)
(deny process-info* (require-not (target same-sandbox)))
(deny signal (require-not (target same-sandbox)))
;; NOTE: another process's argv and environment (`ps eww`, KERN_PROCARGS2) are readable
;; whatever is denied here (a known limitation, docs/phase5a-plan.md): secrets never sit in an
;; env or argv. This line is belt and braces for macOS versions that do gate it.
(deny sysctl-read (sysctl-name "kern.procargs2"))

;; ---- network -----------------------------------------------------------------------------
;; the daemon's API and Ollama, on every address (loopback and the LAN IP)
(deny network-outbound (remote ip "*:7777") (remote ip "*:11434"))
(deny network-bind (local ip "*:7777") (local ip "*:11434"))
;; unix sockets: deny by default (docker, ssh-agent, any daemon), mDNSResponder only
(deny network-outbound (remote unix-socket))
(allow network-outbound (literal "/private/var/run/mDNSResponder"))

;; ---- last word: nothing below may be undone by an allow above ----------------------------
;; persistence paths (login items, shell startup, Claude config, cron, ssh) and terminals
(deny file-write*
  (literal (param "HOME"))
  (subpath (string-append (param "HOME") "/Library"))
  (subpath (string-append (param "HOME") "/.claude"))
  (subpath (string-append (param "HOME") "/.ssh"))
  (subpath (string-append (param "HOME") "/.config"))
  (subpath (string-append (param "HOME") "/.resonant"))
  (literal (string-append (param "HOME") "/.zshrc"))
  (literal (string-append (param "HOME") "/.zshenv"))
  (literal (string-append (param "HOME") "/.zprofile"))
  (literal (string-append (param "HOME") "/.zlogin"))
  (literal (string-append (param "HOME") "/.bashrc"))
  (literal (string-append (param "HOME") "/.bash_profile"))
  (literal (string-append (param "HOME") "/.profile"))
  (literal (string-append (param "HOME") "/.gitconfig"))
  (regex #"^/dev/ttys[0-9]+")
  (literal "/dev/ptmx"))
;; the runner's token files, briefly on disk under runner.secrets_dir
(deny file-read* file-write*
  (subpath (param "SECRETS"))
;; runner.deny_read: the owner's extra paths
;; @DENY_READ@
  )

;; ---- secret files: denied for read AND write, wherever they sit -----------------------------
;; Credentials the owner keeps next to their code (~/trading/.env with exchange keys) or in
;; the usual tool homes. Last in the file so no allow above can undo them (SBPL: last match
;; wins). The name rules (.env, *.pem, *.p12, *.key) spare the run dir, the cache and the
;; toolchain read paths, so a repo's own committed files and a package's bundled cacert.pem
;; still work, and spare the system roots (the OS cert bundles are *.pem). SBPL regexes are
;; POSIX extended, matched against the whole real path; #"..." is a raw string, so `\.` is
;; the regex's escaped dot. No lookahead exists, hence the require-not for the templates.
(deny file-read* file-write*
  (require-all
    (require-any
      (regex #"/\.env$")
      (regex #"/\.env\.[^/]*$")
      (regex #"\.pem$")
      (regex #"\.p12$")
      (regex #"\.key$"))
    ;; committed templates carry no secrets
    (require-not (regex #"/\.env\.(example|sample|template)$"))
    (require-not (subpath "/System"))
    (require-not (subpath "/usr"))
    (require-not (subpath "/Library"))
    (require-not (subpath "/Applications"))
    (require-not (subpath "/private/etc"))
    (require-not (subpath "/opt/homebrew"))
    ;; the run's own files and the toolchain paths
    (require-not (require-any
;; @SECRET_EXEMPT@
      ))))
;; fixed credential files and dirs under $HOME (profile.py HOME_SECRETS), even when a
;; read path above sits inside one
(deny file-read* file-write*
  (subpath (string-append (param "HOME") "/.ssh"))
  (subpath (string-append (param "HOME") "/.aws"))
  (subpath (string-append (param "HOME") "/.config/gh"))
  (literal (string-append (param "HOME") "/.netrc"))
  (literal (string-append (param "HOME") "/.npmrc"))
  (literal (string-append (param "HOME") "/.pypirc"))
  (literal (string-append (param "HOME") "/.docker/config.json"))
  (subpath (string-append (param "HOME") "/.kube"))
  (subpath (string-append (param "HOME") "/.gnupg")))
