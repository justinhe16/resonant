;; The thin guard: Seatbelt profile for Claude workers (docs/employee-plan.md, D2).
;; Allow by default. A worker reads, writes, connects and runs like the owner at the
;; keyboard, except for the enumerated denies below, which protect Resonant itself: its
;; state, its daemon and kill switch, iMessage, auto-start entries and the Keychain.
;; SBPL is last-match-wins and nothing below the first deny is an allow, so every deny holds.
;; Every path arrives as a -D parameter (see profile.py); nothing is spliced into this text.
(version 1)
(allow default)

;; ---- Resonant's state and the installed daemon: no writes ----------------------------------
;; ~/.resonant (DB, config, logs, run secrets) and the daemon's code, venv, interpreter and
;; the binaries it runs outside the guard (profile.default_protected), plus the real targets
;; of any symlinked path in this file (profile.SandboxParams.resolved). The PATH dirs
;; (~/.local/bin, /opt/homebrew/bin) stay writable: the daemon never looks a tool up there.
(deny file-write*
  (subpath (string-append (param "HOME") "/.resonant"))
;; @PROTECT@
  )

;; ---- auto-start and persistence: no writes -------------------------------------------------
;; login items and LaunchAgents (~/Library), shell and git startup files, Claude and ssh
;; config, ~/.config; the system LaunchAgents/LaunchDaemons, the login-item (BTM) store and
;; the cron and at spools (/usr/lib/cron is a symlink to /private/var/at).
(deny file-write*
  (literal (param "HOME"))
  (subpath (string-append (param "HOME") "/Library"))
  (subpath (string-append (param "HOME") "/.claude"))
  (subpath (string-append (param "HOME") "/.ssh"))
  (subpath (string-append (param "HOME") "/.config"))
  (literal (string-append (param "HOME") "/.zshrc"))
  (literal (string-append (param "HOME") "/.zshenv"))
  (literal (string-append (param "HOME") "/.zprofile"))
  (literal (string-append (param "HOME") "/.zlogin"))
  (literal (string-append (param "HOME") "/.zlogout"))
  (literal (string-append (param "HOME") "/.bashrc"))
  (literal (string-append (param "HOME") "/.bash_profile"))
  (literal (string-append (param "HOME") "/.bash_login"))
  (literal (string-append (param "HOME") "/.profile"))
  (literal (string-append (param "HOME") "/.gitconfig"))
  (subpath "/Library/LaunchAgents")
  (subpath "/Library/LaunchDaemons")
  (subpath "/Library/StartupItems")
  (subpath "/private/var/at")
  (subpath "/private/var/db/com.apple.backgroundtaskmanagement"))

;; ---- never readable or writable --------------------------------------------------------------
;; the runner's token files (runner.secrets_dir), Messages data, the Keychain files, and the
;; owner's extra paths (runner.deny_read)
(deny file-read* file-write*
  (subpath (param "SECRETS"))
  (subpath (string-append (param "HOME") "/Library/Messages"))
  (subpath (string-append (param "HOME") "/Library/Keychains"))
  (subpath "/Library/Keychains")
;; @DENY_READ@
  )

;; ---- the worker CLI's control dirs (EM-3) -------------------------------------------------
;; <work_dir>/.ctl/R<n> holds each run's socket and token. A session writes none of them,
;; reads only its own, and connects to no unix socket under work_dir but its own run dir's
;; and its own control dir's: it can neither speak for another run nor stand in for the
;; daemon on another run's socket. (Filled in only for a session; see profile.render.)
;; @CTL@

;; ---- the ancestors of everything above: no rename, no delete ---------------------------------
;; A subpath rule follows the path, not the files: renaming a parent dir would carry a
;; protected tree out from under it (and a fresh one could be put in its place). A literal
;; deny on each ancestor stops that and still lets a worker create entries beside it.
(deny file-write*
;; @ANCESTORS@
  )

;; ---- mounts: no disk image or other filesystem laid over a protected path ---------------
(deny file-mount)

;; ---- exec ------------------------------------------------------------------------------------
;; launchctl and the cron/at front ends (the launchd mach deny below does the real work), and
;; the daemon's own venv and `resonant` entry point
(deny process-exec
  (literal "/bin/launchctl")
  (literal "/usr/bin/crontab")
  (literal "/usr/bin/at")
;; @DENY_EXEC@
  )

;; ---- mach / IPC: nothing acts outside the sandbox as the owner -----------------------------
(deny mach-lookup
  ;; launchd job control (load, kill, bootout of Resonant's jobs)
  (global-name-prefix "com.apple.xpc.launchd")
  ;; the Keychain: securityd and its agents. trustd stays reachable (TLS needs it).
  (global-name "com.apple.SecurityServer")
  (global-name-prefix "com.apple.securityd")
  (global-name-prefix "com.apple.security.agent")
  (global-name "com.apple.security.kcsharing")
  (global-name "com.apple.security.KeychainStasher")
  (global-name "com.apple.security.cloudkeychainproxy3")
  (global-name "com.apple.security.octagon")
  (global-name "com.apple.keychainsharingmessagingd")
  (global-name "com.apple.systemkeychain")
  (global-name-prefix "com.apple.security.authhost")
  ;; iMessage: the Messages agents, and the routes that drive Messages.app as the owner
  ;; (Apple Events, LaunchServices, synthetic input, accessibility, TCC)
  (global-name-prefix "com.apple.imagent")
  (global-name-prefix "com.apple.imdpersistence")
  (global-name-prefix "com.apple.imcore")
  (global-name "com.apple.iChat")
  (global-name-prefix "com.apple.MobileSMS")
  (global-name "com.apple.coreservices.appleevents")
  (global-name "com.apple.coreservices.appleevent-send")
  (global-name "com.apple.coreservices.launchservicesd")
  (global-name-prefix "com.apple.lsd.")
  (global-name-prefix "com.apple.windowserver")
  (global-name-prefix "com.apple.hidsystem")
  (global-name-prefix "com.apple.accessibility")
  (global-name-prefix "com.apple.universalaccessd")
  (global-name-prefix "com.apple.tccd"))
;; Apple Events and LaunchServices opens are checked as operations, not only as lookups
(deny appleevent-send)
(deny lsopen)
;; synthetic input straight through the HID drivers
(deny iokit-open-user-client
  (iokit-user-client-class "IOHIDParamUserClient")
  (iokit-user-client-class "IOHIDLibUserClient")
  (iokit-user-client-class "IOHIDEventServiceUserClient"))

;; ---- other processes: the daemon and the kill switch ---------------------------------------
;; (target same-sandbox), not (target others): a worker still kills its own children
(deny signal (require-not (target same-sandbox)))
(deny mach-priv-task-port)
(deny mach-task-name)

;; ---- network: everything except the daemon's API port, on every address ------------------
(deny network-outbound (remote ip "*:7777"))
(deny network-bind (local ip "*:7777"))
