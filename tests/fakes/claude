#!/usr/bin/env python3
"""A fake Claude Code CLI for the runner tests: ``claude -p`` with stream-json output.

It takes the flags the runner passes (and ignores most), reads stream-json on stdin like the
real CLI with ``--input-format stream-json`` (RC-1), and acts out one scenario, chosen by an
extra ``--scenario NAME`` the test puts in ``claude_cmd``. Only the standard library. cwd is the run's worktree (or scratch dir) and
``TMPDIR`` is ``<run>/tmp``, which is where it leaves notes for the test:
``argv.json`` (flags, env, cwd and the prompt of every invocation) and
pid files.

Like the real session (docs/repos-plan.md D10) it pushes its branch to ``origin``, opens the PR with
``gh pr create`` and waits with ``gh pr checks --watch`` (both are the test's fake gh); ``--no-push``
and ``--no-pr`` skip those, and ``--ci-fixes N`` makes it push N more commits as if CI had failed.

Scenarios: happy, nochanges, slow, hang, hang_then_ok, escapee, usage_limit, error, maxturns,
maxbudget, preinit_hang, stubborn, cachefill, longline, leak, disk, diskgrow, diskpartial, makefile, github, noresult, tokens,
scratch (a run with no repo: writes notes in its cwd and reports), sticky (a scratch run that
never exits on its own, not even when stdin closes).

Stream-json input (RC-1). A reader thread takes stdin lines: ``user`` messages queue up as
turns (each noted in ``<run>/tmp/turns.json`` with the pid), and a ``control_request``
``remote_control`` is answered at once per ``--rc``: ``ok`` (a ``session_url`` naming the pid,
then ``bridge_state`` events), ``error`` or ``none`` (never answered); each request is noted in
``rc.json``. The first message is the prompt. After its final ``result`` the process stays
idle like the real CLI: another message is another turn (the rest of the work if the first turn
ended waiting for an answer, else a short reply), and only the end of stdin makes it exit.
``--owner-turn TEXT`` adds a turn right after the first result, as if the owner typed it over
Remote Control (a second ``result`` Resonant didn't ask for). ``--linger S``: after ``resonant
ask`` gives up, keep working up to S seconds; a message that arrives then is folded into the
turn, as the real CLI does with a message written mid-turn.

The worker CLI (EM-3), on the first turn only, before the scenario: ``--note TEXT`` runs
``resonant note`` (``--urgent-note TEXT``: ``resonant note TEXT --urgent``), ``--check SYSTEM:ACTION:WHAT`` runs ``resonant check`` (denied: the turn
ends there with ``Didn't: denied.``), ``--ask TEXT`` (with ``--options``) runs ``resonant ask``
(no answer yet, exit 3: the turn ends with ``Waiting for the owner.``; ``--ask-map JSON``
picks the question, ``"text|opt,opt"``, by a key found in the prompt), and ``--wait-message S``
calls ``resonant note`` for up to S seconds until a reply carries an owner message. Each call
is noted in ``<run>/tmp/cli.json`` (argv, exit code, output). ``--check-flag F`` (repeatable)
adds a flag such as ``--irreversible`` to the ``check`` call.

Ask mode (BR-5): an argv with ``--restricted`` is an ``ask_claude`` session (``_ask_mode``
below): the question on stdin, an ``init`` event with the allowed built-ins and fake
connector tools, then an answer, a usage limit, an error, a hang or an escaped child.

``--guard-probe JSON`` (EM-9, under the real thin guard): before anything else, try what a worker
may and may not do and write ``<run>/tmp/guard.json``. Keys: ``env`` (read this name in cwd, the
checkout's linked ``.env``), ``state`` (create a file in this dir, the daemon's state),
``pid`` (signal 0 to this process, the daemon), ``keychain``/``service`` (``security
find-generic-password -w`` on this keychain file).
"""

from __future__ import annotations

import argparse
import json
import os
import signal
import queue
import subprocess
import sys
import threading
import time
from datetime import UTC, datetime
from typing import Any


# --- ask mode (BR-5): `claude -p --restricted ...` for ask_claude (runners/ask.py) ---------
# Taken when the argv has --restricted (only the ask session passes it). The question comes on
# stdin. The test adds: --notes DIR (argv.json: argv, cwd, prompt, the cwd's files, which
# credential variables are set and the marker; pid.json: pids), --scenario (answer,
# usage_limit, hang, escapee, error, maxturns, noresult, slow), --answer TEXT, --connectors
# (comma list of extra tool names for the init event; default: fake Calendar and Gmail tools,
# reads and writes), --drop (comma list of tools left out of the init event), --sleep S.
FAKE_CONNECTORS = (
    "mcp__claude_ai_Google_Calendar__list_calendars,mcp__claude_ai_Google_Calendar__list_events,"
    "mcp__claude_ai_Google_Calendar__get_event,mcp__claude_ai_Google_Calendar__search_events,"
    "mcp__claude_ai_Google_Calendar__suggest_time,mcp__claude_ai_Google_Calendar__create_event,"
    "mcp__claude_ai_Google_Calendar__update_event,mcp__claude_ai_Google_Calendar__delete_event,"
    "mcp__claude_ai_Google_Calendar__respond_to_event,mcp__claude_ai_Gmail__search_threads,"
    "mcp__claude_ai_Gmail__get_thread,mcp__claude_ai_Gmail__create_draft,"
    "mcp__claude_ai_Gmail__send_message"
)


def _ask_mode() -> None:
    aap = argparse.ArgumentParser()
    aap.add_argument("-p", action="store_true")
    aap.add_argument("--restricted", action="store_true")
    aap.add_argument("--tools")
    aap.add_argument("--permission-mode")
    aap.add_argument("--allowedTools")
    aap.add_argument("--disallowedTools")
    aap.add_argument("--settings")
    aap.add_argument("--add-dir", action="append", default=[])
    aap.add_argument("--no-session-persistence", action="store_true")
    aap.add_argument("--output-format")
    aap.add_argument("--verbose", action="store_true")
    aap.add_argument("--max-turns")
    aap.add_argument("--max-budget-usd")
    aap.add_argument("--append-system-prompt")
    aap.add_argument("--notes")
    aap.add_argument("--scenario", default="answer")
    aap.add_argument("--answer", default="Mycelium is in ~/code/mycelium.")
    aap.add_argument("--connectors", default=FAKE_CONNECTORS)
    aap.add_argument("--drop", default="")
    aap.add_argument("--sleep", type=float, default=0.0)
    a = aap.parse_args()
    prompt = sys.stdin.read()

    def out(obj: dict[str, Any]) -> None:
        sys.stdout.write(json.dumps(obj) + "\n")
        sys.stdout.flush()

    def keep(name: str, obj: Any) -> None:
        if a.notes:
            with open(os.path.join(a.notes, name), "w") as f:
                json.dump(obj, f)

    creds = [k for k in ("CLAUDE_CODE_OAUTH_TOKEN", "ANTHROPIC_API_KEY") if k in os.environ]
    keep("argv.json", {"argv": sys.argv[1:], "cwd": os.getcwd(), "prompt": prompt,
                       "files": sorted(os.listdir(".")), "creds": creds,
                       "marker": os.environ.get("RESONANT_RUN"), "home": os.environ.get("HOME"),
                       "env": sorted(os.environ)})  # fmt: skip
    pids = {"leader": os.getpid()}
    dropped = set(filter(None, a.drop.split(",")))
    tools = [t for t in (a.tools or "").split(",") if t and t not in dropped]
    tools += [t for t in a.connectors.split(",") if t and t not in dropped]
    servers = sorted({t.split("__")[1] for t in tools if t.startswith("mcp__")})
    out({"type": "system", "subtype": "init", "session_id": "fake-ask", "tools": tools,
         "mcp_servers": [{"name": s, "status": "connected"} for s in servers],
         "permissionMode": a.permission_mode})  # fmt: skip
    if a.scenario == "escapee":
        child = subprocess.Popen([sys.executable, "-c", "import time; time.sleep(600)"],
                                 start_new_session=True)  # fmt: skip
        pids["escapee"] = child.pid
    keep("pid.json", pids)
    if a.scenario in ("hang", "escapee"):
        time.sleep(600)
    if a.sleep:
        time.sleep(a.sleep)
    out({"type": "assistant", "message": {"content": [{"type": "text", "text": "..."}]}})
    if a.scenario == "noresult":
        sys.exit(1)
    if a.scenario == "usage_limit":
        reset = int(time.time() + 3600)
        out({"type": "result", "subtype": "error_during_execution", "is_error": True,
             "result": f"Claude AI usage limit reached|{reset}"})  # fmt: skip
        sys.exit(1)
    if a.scenario in ("error", "maxturns"):
        sub = "error_max_turns" if a.scenario == "maxturns" else "error_during_execution"
        out({"type": "result", "subtype": sub, "is_error": True, "result": ""})
        sys.exit(1)
    out({"type": "result", "subtype": "success", "is_error": False, "result": a.answer,
         "num_turns": 2, "total_cost_usd": 0.01})  # fmt: skip
    sys.exit(0)


if "--restricted" in sys.argv[1:]:
    _ask_mode()


ap = argparse.ArgumentParser()
ap.add_argument("-p", action="store_true")
ap.add_argument("-n", "--name")
ap.add_argument("--input-format")
ap.add_argument("--session-id")
ap.add_argument("--resume")
ap.add_argument("--output-format")
ap.add_argument("--verbose", action="store_true")
ap.add_argument("--permission-mode")
ap.add_argument("--strict-mcp-config", action="store_true")
ap.add_argument("--setting-sources")
ap.add_argument("--settings")
ap.add_argument("--append-system-prompt")
ap.add_argument("--max-turns")
ap.add_argument("--max-budget-usd")
ap.add_argument("--scenario", default="happy")
ap.add_argument("--sleep", type=float, default=0.0)
ap.add_argument("--leak", action="append", default=[])
ap.add_argument("--reset-in", type=float, default=120.0)
ap.add_argument("--file", default="claude-fix.txt")
ap.add_argument("--no-push", action="store_true")
ap.add_argument("--no-pr", action="store_true")
ap.add_argument("--ci-fixes", type=int, default=0)
ap.add_argument("--echo-token", action="store_true")
ap.add_argument("--ask")
ap.add_argument("--options")
ap.add_argument("--ask-map")  # JSON {"<text in the prompt>": "<question>[|opt,opt]"}
ap.add_argument("--note")
ap.add_argument("--urgent-note")
ap.add_argument("--check")
ap.add_argument("--check-flag", action="append", default=[])
ap.add_argument("--guard-probe")
ap.add_argument("--wait-message", type=float, default=0.0)
ap.add_argument("--bash", action="append", default=[])  # Bash tool calls shown, not run (TR-1)
ap.add_argument("--self-op", action="append", default=[])  # resonant restart|update, in order
ap.add_argument("--rc", default="ok", choices=("ok", "error", "none"))
ap.add_argument("--owner-turn")
ap.add_argument("--linger", type=float, default=0.0)
args = ap.parse_args()

session = args.resume or args.session_id
# cwd is the run's worktree (or scratch dir); TMPDIR is <run>/tmp whatever the guard (HOME is
# <run>/home under the thin guard, the owner's HOME with it off)
run_dir = os.path.dirname(os.environ["TMPDIR"].rstrip("/"))
tmp = os.path.join(run_dir, "tmp")
scenario = args.scenario
_out = threading.Lock()
_files = threading.Lock()


def emit(obj: dict[str, Any]) -> None:
    with _out:
        sys.stdout.write(json.dumps(obj) + "\n")
        sys.stdout.flush()


def note(name: str, text: str) -> None:
    with open(os.path.join(tmp, name), "w") as f:
        f.write(text)


def append(name: str, entry: Any) -> None:
    with _files:
        path = os.path.join(tmp, name)
        items = json.load(open(path)) if os.path.exists(path) else []
        items.append(entry)
        note(name, json.dumps(items))


# --- stdin: stream-json in (RC-1) ---
messages: queue.Queue[str | None] = queue.Queue()


def control(msg: dict[str, Any]) -> None:
    rid, req = msg.get("request_id"), msg.get("request") or {}
    append("rc.json", {"pid": os.getpid(), "request": req, "at": time.time()})
    if req.get("subtype") != "remote_control" or args.rc == "none":
        return
    if args.rc == "error":
        emit({"type": "control_response", "response": {"subtype": "error", "request_id": rid,
              "error": "Remote Control requires a claude.ai login"}})  # fmt: skip
        return
    url = f"https://claude.ai/code/session_fake{os.getpid()}"
    body = {"session_url": url} if req.get("enabled") else {}
    emit({"type": "control_response",
          "response": {"subtype": "success", "request_id": rid, "response": body}})  # fmt: skip
    if req.get("enabled"):
        emit({"type": "system", "subtype": "bridge_state", "state": "ready"})


def text_of(content: Any) -> str:
    if isinstance(content, str):
        return content
    return "".join(b.get("text", "") for b in content if isinstance(b, dict))


def reader() -> None:
    for line in sys.stdin:
        try:
            msg = json.loads(line)
        except ValueError:
            continue
        if msg.get("type") == "control_request":
            control(msg)
        elif msg.get("type") == "user":
            messages.put(text_of(msg["message"]["content"]))
    messages.put(None)


threading.Thread(target=reader, daemon=True).start()


def take(timeout: float | None = None, *, folded: bool = False) -> str | None:
    """The next user message (None: stdin ended), noted in turns.json. With ``timeout``, a
    queue.Empty when none came."""
    text = messages.get(timeout=timeout)
    if text is not None:
        append("turns.json", {"pid": os.getpid(), "text": text, "folded": folded})
    return text


prompt = take()
if prompt is None:
    sys.exit(1)


def git(*argv: str) -> None:
    subprocess.run(["git", "-c", "commit.gpgsign=false", *argv], check=True, capture_output=True)


def commit(files: dict[str, str], message: str = "Fix it") -> None:
    for name, text in files.items():
        path = os.path.join(os.getcwd(), name)
        os.makedirs(os.path.dirname(path), exist_ok=True)
        with open(path, "w") as f:
            f.write(text)
    git("add", "-A")
    git("commit", "-q", "-m", message)


def out(*argv: str) -> str:
    """Run a tool the way the session does (PATH is the run-local bin) and note what it did."""
    done = subprocess.run(argv, capture_output=True, text=True)
    append("tools.json", {"argv": list(argv), "rc": done.returncode, "stderr": done.stderr[-300:]})
    return done.stdout.strip()


def deliver() -> None:
    """Push the branch, open the PR and watch CI, as the prompt tells the session to."""
    branch = out("git", "rev-parse", "--abbrev-ref", "HEAD")
    if args.no_push:
        return
    out("git", "push", "-q", "-u", "origin", branch)
    if args.no_pr:
        return
    out("gh", "pr", "create", "--base", "main", "--head", branch,
        "--title", "Fix the flaky test", "--body", "Fixed by the fake session.")  # fmt: skip
    out("gh", "pr", "checks", "--watch")
    for i in range(args.ci_fixes):
        commit({f"ci-fix-{i}.txt": "fix\n"}, f"Fix CI {i}")
        out("git", "push", "-q", "origin", branch)
        out("gh", "pr", "checks", "--watch")


def result(text: str = "Fixed it.", **extra: Any) -> None:
    emit(
        {
            "type": "result",
            "subtype": "success",
            "is_error": False,
            "result": text,
            "session_id": session,
            "total_cost_usd": 0.0123,
            "usage": {"input_tokens": 11, "output_tokens": 7},
            **extra,
        }
    )


# Every invocation leaves a record: the test checks flags, env and prompt.
log = os.path.join(tmp, "argv.json")
history: list[Any] = json.load(open(log)) if os.path.exists(log) else []
history.append({"argv": sys.argv[1:], "env": dict(os.environ), "prompt": prompt, "pid": os.getpid(),
                "cwd": os.getcwd()})
note("argv.json", json.dumps(history))


def probe_creds(name: str = "creds.json") -> None:
    """What the session can read of its own credentials, and of a sibling run's."""
    creds = os.path.join(run_dir, "creds")

    def read(path: str) -> str:
        try:
            return open(path).read().strip()
        except OSError as e:
            return f"ERR {e.errno}"

    hosts = read(os.path.join(creds, "gh", "hosts.yml"))
    token = ""
    for line in hosts.splitlines():
        if "oauth_token:" in line:
            token = line.split(":", 1)[1].strip()
    note(name, json.dumps({
        "token": read(os.path.join(creds, "token")),
        "hosts_token": token,
        "gh_config_dir": os.environ.get("GH_CONFIG_DIR"),
        "modes": [oct(os.stat(creds).st_mode & 0o777)] if os.path.isdir(creds) else [],
        "sibling": read(os.path.join(os.path.dirname(run_dir), "R9", "creds", "token")),
    }))  # fmt: skip


def guard_probe(spec: dict[str, Any]) -> None:
    """What the thin guard lets a worker do (EM-9): each entry is ``ok…`` or ``denied …``."""

    def attempt(fn: Any) -> str:
        try:
            return "ok " + str(fn())
        except OSError as e:
            return f"denied {e.errno}"

    def write_state() -> str:
        path = os.path.join(spec["state"], "worker-was-here")
        with open(path, "w") as f:
            f.write("x")
        return path

    res: dict[str, str] = {
        "env": attempt(lambda: open(spec["env"]).read().strip()),
        "state": attempt(write_state),
        "signal": attempt(lambda: os.kill(spec["pid"], 0)),
    }
    if spec.get("keychain"):
        done = subprocess.run(["/usr/bin/security", "find-generic-password", "-s", spec["service"],
                               "-w", spec["keychain"]], capture_output=True, text=True)  # fmt: skip
        res["keychain"] = f"rc {done.returncode} {done.stdout.strip()}"
    note("guard.json", json.dumps(res))


if args.guard_probe:
    guard_probe(json.loads(args.guard_probe))
probe_creds()
note("claude.pid", str(os.getpid()))

if scenario == "preinit_hang":  # dies before Claude ever writes a session
    time.sleep(3600)
if scenario == "stubborn":
    signal.signal(signal.SIGTERM, signal.SIG_IGN)

emit({"type": "system", "subtype": "init", "session_id": session, "cwd": os.getcwd()})
emit({"type": "assistant", "message": {"content": [{"type": "text", "text": "working on it"}]}})
for n, command in enumerate(args.bash):
    tid = f"toolu_bash_{n}"
    emit({"type": "assistant", "timestamp": datetime.now(UTC).isoformat(),
          "message": {"content": [{"type": "tool_use", "id": tid, "name": "Bash",
                                   "input": {"command": command}}]}})
    emit({"type": "user", "message": {"content": [{"type": "tool_result", "tool_use_id": tid,
                                                  "content": "ok"}]}})



def cli(*argv: str) -> tuple[int, str]:
    """``resonant …`` as the session runs it (from PATH), noted for the test."""
    done = subprocess.run(["resonant", *argv], capture_output=True, text=True)
    append("cli.json", {"argv": list(argv), "rc": done.returncode, "out": done.stdout.strip(),
                        "err": done.stderr[-300:]})  # fmt: skip
    return done.returncode, done.stdout


def first_steps() -> bool:
    """The worker CLI steps of a session's first turn. False: the turn ended here."""
    if args.note:
        cli("note", args.note)
    if args.urgent_note:
        cli("note", args.urgent_note, "--urgent")
    if args.check:
        system, action, what = args.check.split(":", 2)
        rc, _ = cli("check", "--system", system, "--action", action, *args.check_flag, what)
        if rc != 0:
            result("Didn't: denied.")
            return False
    if args.wait_message:
        end = time.time() + args.wait_message
        while time.time() < end:
            _rc, text = cli("note", "still going")
            if "Message from the owner" in text:
                break
            try:  # a message written into the live session is folded into this turn
                if "Message from the owner" in (take(0.2, folded=True) or ""):
                    break
            except queue.Empty:
                pass
    if args.ask_map:  # runs started with different asks ask different questions
        for needle, value in json.loads(args.ask_map).items():
            if needle in prompt:
                args.ask, _, opts = value.partition("|")
                args.options = opts or None
                break
    for op in args.self_op:  # GD-1: `resonant restart` / `resonant update`
        rc, text = cli(op)
        if rc == 0 and "restarts in about" in text:
            time.sleep(3600)  # as told: wait for the restart to stop the session
        if rc != 0:
            result(f"Didn't {op}: {text.strip()[:80]}")
            return False
    if args.ask:
        extra = ["--options", args.options] if args.options else []
        rc, _ = cli("ask", args.ask, *extra)
        if rc == 3:
            if args.linger:  # finish what it can; an answer written meanwhile joins this turn
                try:
                    take(args.linger, folded=True)
                    return True
                except queue.Empty:
                    pass
            result("Waiting for the owner.")
            return False
    return True


def work(resumed: bool) -> bool:
    """One turn of the scenario, ending with its result (or the process). False: the turn
    ended before the work (a denied check, a question with no answer yet)."""
    if not resumed and not first_steps():
        return False
    if scenario in ("hang", "stubborn") or (scenario == "hang_then_ok" and not resumed):
        time.sleep(3600)
        sys.exit(0)
    elif scenario == "usage_limit" and not os.path.exists(os.path.join(tmp, "limit-seen")):
        note("limit-seen", "1")
        reset = int(time.time() + args.reset_in)
        emit(
            {
                "type": "result",
                "subtype": "error_during_execution",
                "is_error": True,
                "result": f"Claude AI usage limit reached|{reset}",
                "session_id": session,
            }
        )
        sys.exit(1)
    elif scenario == "error":
        emit({"type": "result", "subtype": "error_during_execution", "is_error": True,
              "result": "boom", "session_id": session})  # fmt: skip
        sys.exit(1)
    elif scenario == "maxturns":
        emit({"type": "result", "subtype": "error_max_turns", "is_error": True,
              "session_id": session})  # fmt: skip
        sys.exit(1)
    elif scenario == "maxbudget":
        emit({"type": "result", "subtype": "error_max_budget_usd", "is_error": True,
              "session_id": session})  # fmt: skip
        sys.exit(1)
    elif scenario == "noresult":
        sys.exit(0)
    elif scenario == "nochanges":
        result("Nothing to change.")
        return True
    elif scenario in ("scratch", "sticky"):
        if args.sleep:
            time.sleep(args.sleep)
        with open("notes.md", "w") as f:
            f.write("the disk is 80% full\n")
        result("Checked the disk: 80% full, the biggest dir is ~/Downloads.")
        return True

    if scenario == "escapee":
        # A child that setsid-ed into its own group, and a grandchild that setsid-ed and lost
        # its parent (reparented to launchd): both outlive the session unless the runner reaps
        # them.
        sleeper = "import time; time.sleep(600)"
        kid = subprocess.Popen([sys.executable, "-c", sleeper], start_new_session=True)
        note("escapee.pid", str(kid.pid))
        middle = (
            "import subprocess, sys; "
            f"p = subprocess.Popen([sys.executable, '-c', {sleeper!r}], start_new_session=True); "
            f"open({os.path.join(tmp, 'orphan.pid')!r}, 'w').write(str(p.pid))"
        )
        subprocess.run([sys.executable, "-c", middle], check=True)
        plain = subprocess.Popen([sys.executable, "-c", sleeper])
        note("child.pid", str(plain.pid))
    if scenario == "leak":
        text = " ".join(args.leak) + " " + json.dumps(dict(os.environ))
        emit({"type": "assistant", "message": {"content": [{"type": "text", "text": text}]}})
    if scenario == "longline":
        emit({"type": "assistant",
              "message": {"content": [{"type": "text", "text": "x" * 2_000_000}]}})  # fmt: skip
        for leak in args.leak:  # a secret right at the cut of a line that is too long
            emit({"type": "assistant", "message": {"content": [{"type": "text",
                  "text": "y" * (1_048_576 - 200) + leak + "z" * 500}]}})  # fmt: skip
    if scenario == "cachefill":
        with open(os.path.join(os.environ["UV_CACHE_DIR"], "big.bin"), "wb") as f:
            f.write(b"\0" * 4_000_000)
        time.sleep(30)
    if scenario == "disk":
        with open(os.path.join(tmp, "big.bin"), "wb") as f:
            f.write(b"\0" * 4_000_000)
        time.sleep(30)
    if scenario == "diskpartial":  # a folder the watchdog can't read for a while, then the work
        locked = os.path.join(tmp, "locked")
        os.mkdir(locked)
        os.chmod(locked, 0)
        time.sleep(1.5)
        os.chmod(locked, 0o700)
    if scenario == "diskgrow":  # a little more every tick, well under any cap
        for i in range(30):
            with open(os.path.join(tmp, f"grow{i}.bin"), "wb") as f:
                f.write(b"\0" * 1_100_000)
            time.sleep(0.1)

    if args.sleep:
        time.sleep(args.sleep)

    if args.echo_token:  # a session that prints its own credentials into the transcript
        creds = os.path.join(run_dir, "creds")
        text = (open(os.path.join(creds, "token")).read()
                + open(os.path.join(creds, "gh", "hosts.yml")).read())  # fmt: skip
        emit({"type": "assistant", "message": {"content": [{"type": "text", "text": text}]}})

    files = {args.file: f"fixed by {session}\n"}
    if scenario == "makefile":
        files.update({"Makefile": "all:\n\ttrue\n", ".claude/settings.json": "{}\n",
                      "package.json": "{}\n"})  # fmt: skip
    if scenario == "github":
        files[".github/workflows/evil.yml"] = "on: push\n"
    if scenario == "tokens":
        files[args.file] = " ".join(args.leak) + "\n"
    commit(files, "Fix the flaky test")
    probe_creds("creds-end.json")
    deliver()
    result("Fixed it. Added " + args.file + ".")
    return True


done = work(resumed=bool(args.resume))
if args.owner_turn:  # the owner typed in the Claude app: a turn Resonant didn't start
    emit({"type": "assistant", "message": {"content": [
        {"type": "text", "text": f"(from the app) {args.owner_turn}"}]}})  # fmt: skip
    result("Answered the owner in the app.")
# Idle like the real CLI: each message is another turn; only the end of stdin ends it.
while True:
    text = take()
    if text is None:
        break
    emit({"type": "assistant", "message": {"content": [{"type": "text", "text": "on it"}]}})
    if not done:
        done = work(resumed=True)
    else:
        result("Carried on: " + text[:60])
if scenario == "sticky":  # never exits on its own, not even after stdin closes
    time.sleep(3600)
sys.exit(0)
