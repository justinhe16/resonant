#!/usr/bin/env python3
"""A fake Claude Code CLI for the runner tests: ``claude -p`` with stream-json output.

It takes the flags the runner passes (and ignores most), reads the prompt on stdin like the
real CLI, and acts out one scenario, chosen by an extra ``--scenario NAME`` the test puts in
``claude_cmd``. Only the standard library. cwd is the run's worktree (or scratch dir) and
``TMPDIR`` is ``<run>/tmp``, which is where it leaves notes for the test:
``argv.json`` (flags, env, cwd and the prompt of every invocation) and
pid files.

Like the real session (docs/repos-plan.md D10) it pushes its branch to ``origin``, opens the PR with
``gh pr create`` and waits with ``gh pr checks --watch`` (both are the test's fake gh); ``--no-push``
and ``--no-pr`` skip those, and ``--ci-fixes N`` makes it push N more commits as if CI had failed.

Scenarios: happy, nochanges, slow, hang, hang_then_ok, escapee, usage_limit, error, maxturns,
maxbudget, preinit_hang, stubborn, cachefill, longline, leak, disk, makefile, github, noresult, tokens,
scratch (a run with no repo: writes notes in its cwd and reports).

The worker CLI (EM-3), on the first turn only, before the scenario: ``--note TEXT`` runs
``resonant note`` (``--urgent-note TEXT``: ``resonant note TEXT --urgent``), ``--check SYSTEM:ACTION:WHAT`` runs ``resonant check`` (denied: the turn
ends there with ``Didn't: denied.``), ``--ask TEXT`` (with ``--options``) runs ``resonant ask``
(no answer yet, exit 3: the turn ends with ``Waiting for the owner.``; ``--ask-map JSON``
picks the question, ``"text|opt,opt"``, by a key found in the prompt), and ``--wait-message S``
calls ``resonant note`` for up to S seconds until a reply carries an owner message. Each call
is noted in ``<run>/tmp/cli.json`` (argv, exit code, output). ``--check-flag F`` (repeatable)
adds a flag such as ``--irreversible`` to the ``check`` call.

``--guard-probe JSON`` (EM-9, under the real thin guard): before anything else, try what a worker
may and may not do and write ``<run>/tmp/guard.json``. Keys: ``env`` (read this name in cwd, the
checkout's linked ``.env``), ``state`` (create a file in this dir, the daemon's state),
``pid`` (signal 0 to this process, the daemon), ``keychain``/``service`` (``security
find-generic-password -w`` on this keychain file).
"""

from __future__ import annotations

import argparse
import json
import os
import signal
import subprocess
import sys
import time
from typing import Any

ap = argparse.ArgumentParser()
ap.add_argument("-p", action="store_true")
ap.add_argument("--session-id")
ap.add_argument("--resume")
ap.add_argument("--output-format")
ap.add_argument("--verbose", action="store_true")
ap.add_argument("--permission-mode")
ap.add_argument("--strict-mcp-config", action="store_true")
ap.add_argument("--setting-sources")
ap.add_argument("--settings")
ap.add_argument("--append-system-prompt")
ap.add_argument("--max-turns")
ap.add_argument("--max-budget-usd")
ap.add_argument("--scenario", default="happy")
ap.add_argument("--sleep", type=float, default=0.0)
ap.add_argument("--leak", action="append", default=[])
ap.add_argument("--reset-in", type=float, default=120.0)
ap.add_argument("--file", default="claude-fix.txt")
ap.add_argument("--no-push", action="store_true")
ap.add_argument("--no-pr", action="store_true")
ap.add_argument("--ci-fixes", type=int, default=0)
ap.add_argument("--echo-token", action="store_true")
ap.add_argument("--ask")
ap.add_argument("--options")
ap.add_argument("--ask-map")  # JSON {"<text in the prompt>": "<question>[|opt,opt]"}
ap.add_argument("--note")
ap.add_argument("--urgent-note")
ap.add_argument("--check")
ap.add_argument("--check-flag", action="append", default=[])
ap.add_argument("--guard-probe")
ap.add_argument("--wait-message", type=float, default=0.0)
ap.add_argument("--self-op", action="append", default=[])  # resonant restart|update, in order
args = ap.parse_args()

prompt = sys.stdin.read()
session = args.resume or args.session_id
# cwd is the run's worktree (or scratch dir); TMPDIR is <run>/tmp whatever the guard (HOME is
# <run>/home under the thin guard, the owner's HOME with it off)
run_dir = os.path.dirname(os.environ["TMPDIR"].rstrip("/"))
tmp = os.path.join(run_dir, "tmp")
scenario = args.scenario


def emit(obj: dict[str, Any]) -> None:
    sys.stdout.write(json.dumps(obj) + "\n")
    sys.stdout.flush()


def note(name: str, text: str) -> None:
    with open(os.path.join(tmp, name), "w") as f:
        f.write(text)


def git(*argv: str) -> None:
    subprocess.run(["git", "-c", "commit.gpgsign=false", *argv], check=True, capture_output=True)


def commit(files: dict[str, str], message: str = "Fix it") -> None:
    for name, text in files.items():
        path = os.path.join(os.getcwd(), name)
        os.makedirs(os.path.dirname(path), exist_ok=True)
        with open(path, "w") as f:
            f.write(text)
    git("add", "-A")
    git("commit", "-q", "-m", message)


def out(*argv: str) -> str:
    """Run a tool the way the session does (PATH is the run-local bin) and note what it did."""
    done = subprocess.run(argv, capture_output=True, text=True)
    path = os.path.join(tmp, "tools.json")
    calls = json.load(open(path)) if os.path.exists(path) else []
    calls.append({"argv": list(argv), "rc": done.returncode, "stderr": done.stderr[-300:]})
    note("tools.json", json.dumps(calls))
    return done.stdout.strip()


def deliver() -> None:
    """Push the branch, open the PR and watch CI, as the prompt tells the session to."""
    branch = out("git", "rev-parse", "--abbrev-ref", "HEAD")
    if args.no_push:
        return
    out("git", "push", "-q", "-u", "origin", branch)
    if args.no_pr:
        return
    out("gh", "pr", "create", "--base", "main", "--head", branch,
        "--title", "Fix the flaky test", "--body", "Fixed by the fake session.")  # fmt: skip
    out("gh", "pr", "checks", "--watch")
    for i in range(args.ci_fixes):
        commit({f"ci-fix-{i}.txt": "fix\n"}, f"Fix CI {i}")
        out("git", "push", "-q", "origin", branch)
        out("gh", "pr", "checks", "--watch")


def result(text: str = "Fixed it.", **extra: Any) -> None:
    emit(
        {
            "type": "result",
            "subtype": "success",
            "is_error": False,
            "result": text,
            "session_id": session,
            "total_cost_usd": 0.0123,
            "usage": {"input_tokens": 11, "output_tokens": 7},
            **extra,
        }
    )


# Every invocation leaves a record: the test checks flags, env and prompt.
log = os.path.join(tmp, "argv.json")
history: list[Any] = json.load(open(log)) if os.path.exists(log) else []
history.append({"argv": sys.argv[1:], "env": dict(os.environ), "prompt": prompt, "pid": os.getpid(),
                "cwd": os.getcwd()})
note("argv.json", json.dumps(history))


def probe_creds(name: str = "creds.json") -> None:
    """What the session can read of its own credentials, and of a sibling run's."""
    creds = os.path.join(run_dir, "creds")

    def read(path: str) -> str:
        try:
            return open(path).read().strip()
        except OSError as e:
            return f"ERR {e.errno}"

    hosts = read(os.path.join(creds, "gh", "hosts.yml"))
    token = ""
    for line in hosts.splitlines():
        if "oauth_token:" in line:
            token = line.split(":", 1)[1].strip()
    note(name, json.dumps({
        "token": read(os.path.join(creds, "token")),
        "hosts_token": token,
        "gh_config_dir": os.environ.get("GH_CONFIG_DIR"),
        "modes": [oct(os.stat(creds).st_mode & 0o777)] if os.path.isdir(creds) else [],
        "sibling": read(os.path.join(os.path.dirname(run_dir), "R9", "creds", "token")),
    }))  # fmt: skip


def guard_probe(spec: dict[str, Any]) -> None:
    """What the thin guard lets a worker do (EM-9): each entry is ``ok…`` or ``denied …``."""

    def attempt(fn: Any) -> str:
        try:
            return "ok " + str(fn())
        except OSError as e:
            return f"denied {e.errno}"

    def write_state() -> str:
        path = os.path.join(spec["state"], "worker-was-here")
        with open(path, "w") as f:
            f.write("x")
        return path

    res: dict[str, str] = {
        "env": attempt(lambda: open(spec["env"]).read().strip()),
        "state": attempt(write_state),
        "signal": attempt(lambda: os.kill(spec["pid"], 0)),
    }
    if spec.get("keychain"):
        done = subprocess.run(["/usr/bin/security", "find-generic-password", "-s", spec["service"],
                               "-w", spec["keychain"]], capture_output=True, text=True)  # fmt: skip
        res["keychain"] = f"rc {done.returncode} {done.stdout.strip()}"
    note("guard.json", json.dumps(res))


if args.guard_probe:
    guard_probe(json.loads(args.guard_probe))
probe_creds()
note("claude.pid", str(os.getpid()))

if scenario == "preinit_hang":  # dies before Claude ever writes a session
    time.sleep(3600)
if scenario == "stubborn":
    signal.signal(signal.SIGTERM, signal.SIG_IGN)

emit({"type": "system", "subtype": "init", "session_id": session, "cwd": os.getcwd()})
emit({"type": "assistant", "message": {"content": [{"type": "text", "text": "working on it"}]}})



def cli(*argv: str) -> tuple[int, str]:
    """``resonant …`` as the session runs it (from PATH), noted for the test."""
    done = subprocess.run(["resonant", *argv], capture_output=True, text=True)
    path = os.path.join(tmp, "cli.json")
    calls = json.load(open(path)) if os.path.exists(path) else []
    calls.append({"argv": list(argv), "rc": done.returncode, "out": done.stdout.strip(),
                  "err": done.stderr[-300:]})  # fmt: skip
    note("cli.json", json.dumps(calls))
    return done.returncode, done.stdout


if not args.resume:
    if args.note:
        cli("note", args.note)
    if args.urgent_note:
        cli("note", args.urgent_note, "--urgent")
    if args.check:
        system, action, what = args.check.split(":", 2)
        rc, _ = cli("check", "--system", system, "--action", action, *args.check_flag, what)
        if rc != 0:
            result("Didn't: denied.")
            sys.exit(0)
    if args.wait_message:
        end = time.time() + args.wait_message
        while time.time() < end:
            _rc, text = cli("note", "still going")
            if "Message from the owner" in text:
                break
            time.sleep(0.2)
    if args.ask_map:  # runs started with different asks ask different questions
        for needle, value in json.loads(args.ask_map).items():
            if needle in prompt:
                args.ask, _, opts = value.partition("|")
                args.options = opts or None
                break
    for op in args.self_op:  # GD-1: `resonant restart` / `resonant update`
        rc, text = cli(op)
        if rc == 0 and "restarts in about" in text:
            time.sleep(3600)  # as told: wait for the restart to stop the session
        if rc != 0:
            result(f"Didn't {op}: {text.strip()[:80]}")
            sys.exit(0)
    if args.ask:
        extra = ["--options", args.options] if args.options else []
        rc, _ = cli("ask", args.ask, *extra)
        if rc == 3:
            result("Waiting for the owner.")
            sys.exit(0)

if scenario in ("hang", "stubborn") or (scenario == "hang_then_ok" and not args.resume):
    time.sleep(3600)
    sys.exit(0)
elif scenario == "usage_limit" and not os.path.exists(os.path.join(tmp, "limit-seen")):
    note("limit-seen", "1")
    reset = int(time.time() + args.reset_in)
    emit(
        {
            "type": "result",
            "subtype": "error_during_execution",
            "is_error": True,
            "result": f"Claude AI usage limit reached|{reset}",
            "session_id": session,
        }
    )
    sys.exit(1)
elif scenario == "error":
    emit({"type": "result", "subtype": "error_during_execution", "is_error": True,
          "result": "boom", "session_id": session})  # fmt: skip
    sys.exit(1)
elif scenario == "maxturns":
    emit({"type": "result", "subtype": "error_max_turns", "is_error": True,
          "session_id": session})  # fmt: skip
    sys.exit(1)
elif scenario == "maxbudget":
    emit({"type": "result", "subtype": "error_max_budget_usd", "is_error": True,
          "session_id": session})  # fmt: skip
    sys.exit(1)
elif scenario == "noresult":
    sys.exit(0)
elif scenario == "nochanges":
    result("Nothing to change.")
    sys.exit(0)
elif scenario == "scratch":
    with open("notes.md", "w") as f:
        f.write("the disk is 80% full\n")
    result("Checked the disk: 80% full, the biggest dir is ~/Downloads.")
    sys.exit(0)

if scenario == "escapee":
    # A child that setsid-ed into its own group, and a grandchild that setsid-ed and lost its
    # parent (reparented to launchd): both outlive the session unless the runner reaps them.
    sleeper = "import time; time.sleep(600)"
    kid = subprocess.Popen([sys.executable, "-c", sleeper], start_new_session=True)
    note("escapee.pid", str(kid.pid))
    middle = (
        "import subprocess, sys; "
        f"p = subprocess.Popen([sys.executable, '-c', {sleeper!r}], start_new_session=True); "
        f"open({os.path.join(tmp, 'orphan.pid')!r}, 'w').write(str(p.pid))"
    )
    subprocess.run([sys.executable, "-c", middle], check=True)
    plain = subprocess.Popen([sys.executable, "-c", sleeper])
    note("child.pid", str(plain.pid))
if scenario == "leak":
    text = " ".join(args.leak) + " " + json.dumps(dict(os.environ))
    emit({"type": "assistant", "message": {"content": [{"type": "text", "text": text}]}})
if scenario == "longline":
    emit({"type": "assistant", "message": {"content": [{"type": "text", "text": "x" * 2_000_000}]}})
    for leak in args.leak:  # a secret right at the cut of a line that is too long
        emit({"type": "assistant", "message": {"content": [{"type": "text",
              "text": "y" * (1_048_576 - 200) + leak + "z" * 500}]}})  # fmt: skip
if scenario == "cachefill":
    with open(os.path.join(os.environ["UV_CACHE_DIR"], "big.bin"), "wb") as f:
        f.write(b"\0" * 4_000_000)
    time.sleep(30)
if scenario == "disk":
    with open(os.path.join(tmp, "big.bin"), "wb") as f:
        f.write(b"\0" * 4_000_000)
    time.sleep(30)

if args.sleep:
    time.sleep(args.sleep)

if args.echo_token:  # a session that prints its own credentials into the transcript
    creds = os.path.join(run_dir, "creds")
    text = open(os.path.join(creds, "token")).read() + open(os.path.join(creds, "gh", "hosts.yml")).read()
    emit({"type": "assistant", "message": {"content": [{"type": "text", "text": text}]}})

files = {args.file: f"fixed by {session}\n"}
if scenario == "makefile":
    files.update({"Makefile": "all:\n\ttrue\n", ".claude/settings.json": "{}\n",
                  "package.json": "{}\n"})
if scenario == "github":
    files[".github/workflows/evil.yml"] = "on: push\n"
if scenario == "tokens":
    files[args.file] = " ".join(args.leak) + "\n"
commit(files, "Fix the flaky test")
probe_creds("creds-end.json")
deliver()
result("Fixed it. Added " + args.file + ".")
sys.exit(0)
