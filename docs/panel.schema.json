              {
                "$ref": "#/$defs/Stat"
              },
              {
                "$ref": "#/$defs/Series"
              },
              {
                "$ref": "#/$defs/Table"
              },
              {
                "$ref": "#/$defs/Status"
              },
              {
                "$ref": "#/$defs/Kv"
              },
              {
                "$ref": "#/$defs/Text"
              },
              {
                "$ref": "#/$defs/Details"
              },
              {
                "$ref": "#/$defs/Price"
              }
            ]
          },
          "maxItems": 24,
          "minItems": 1,
          "title": "Widgets",
          "type": "array"
        }
      },
      "required": [
        "id",
        "title",
        "widgets"
      ],
      "title": "View",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "What a panel command prints on stdout.",
  "properties": {
    "actions": {
      "default": [],
      "items": {},
      "maxItems": 0,
      "title": "Actions",
      "type": "array"
    },
    "health": {
