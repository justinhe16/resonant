    "Trade": {
      "additionalProperties": false,
      "description": "A position on the chart: entered at ``entry_t``/``entry_px``, exited at\n``exit_t``/``exit_px`` (both null while it is open). ``pnl`` is its money result.",
      "properties": {
        "currency": {
          "anyOf": [
            {
              "pattern": "^[A-Z]{3}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Currency"
        },
        "entry_px": {
