        "text": {
          "title": "Text",
          "type": "string",
          "x-cut-at": 800
        },
        "title": {
          "anyOf": [
            {
              "type": "string",
              "x-cut-at": 64
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Title"
