    "View": {
      "additionalProperties": false,
      "description": "A tab of the panel. At most 24 widgets (48 per panel).",
      "properties": {
        "id": {
          "pattern": "^[a-z0-9][a-z0-9_-]{0,31}$",
          "title": "Id",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string",
          "x-cut-at": 40
        },
        "widgets": {
          "items": {
            "discriminator": {
              "mapping": {
                "details": "#/$defs/Details",
                "kv": "#/$defs/Kv",
                "price": "#/$defs/Price",
                "series": "#/$defs/Series",
                "stat": "#/$defs/Stat",
                "status": "#/$defs/Status",
                "table": "#/$defs/Table",
                "text": "#/$defs/Text"
