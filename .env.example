# Resonant reads config from ~/.resonant/config.yaml. Any field can be overridden
# with RESONANT_<FIELD>, using "__" for nesting. Secrets do NOT go here: they live
# in the macOS Keychain and only the executor reads them.

# RESONANT_HOME=~/.resonant
# RESONANT_DRY_RUN=true
# RESONANT_MODEL__NAME=qwen3:30b-a3b
# RESONANT_API__PORT=7777
